ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-opus-4-8
NEXT_PUBLIC_APP_URL=https://your-public-domain.example

# Basic auth for the app itself (see src/proxy.js)
ADMIN_USER=
ADMIN_PASSWORD=

# Shared secret that lets a scheduler (Vercel Cron or a systemd timer on the
# VM) call /api/schedule/process and /api/posts/sync-all without basic auth.
# Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Postgres API (PostgREST behind Caddy on the VM — see sql/schema.sql)
SALON_API_URL=https://api.yourdomain.com
SALON_API_KEY=your_shared_x_api_key_secret
SALON_JWT_SECRET=same_secret_configured_in_postgrest_conf

# Cloudflare R2 (S3-compatible object storage for uploaded media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.yourdomain.example

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v19.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-public-domain.example/api/linkedin/callback
LINKEDIN_COMPANY_ID=

# Lead-notification email (booth-rental inquiries from /rent).
# Who gets notified (comma-separated). Defaults to the salon owners if unset.
LEAD_NOTIFY_TO=nay3li@live.com, adamschoenwetter@outlook.com
# The "From" address. For Resend this must be on a domain you've verified.
LEAD_NOTIFY_FROM=Keeping It Cute <notifications@keepingitcutesalonandspa.com>
# Option A — Resend (recommended): set this and verify your sending domain.
RESEND_API_KEY=
# Option B — any SMTP server (Gmail app password, etc.). Used only if RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
